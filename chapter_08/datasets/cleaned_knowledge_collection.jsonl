{"document_id": "TRV-PORTAL-V3", "policy_id": "TRAVEL", "knowledge_type": "travel_policy", "title": "Global Travel Policy", "version": "3.0", "status": "approved", "owner": "People Operations", "source_system": "HR Portal", "source_type": "policy", "effective_date": "2025-01-01", "last_reviewed": "2025-01-15", "content": "Employees may book economy airfare. Manager approval is required for trips over $2,000. Expense reports are due within 30 days.", "content_hash": "6e937033bebe7b14a3670e259e653313810bb4c90353ca9ca3cdc1f550fec2e5"}
